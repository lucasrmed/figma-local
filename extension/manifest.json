{
  "manifest_version": 3,
  "name": "Figma Local",
  "version": "0.3.0",
  "description": "Capture telas do Figma e consulte um índice local com contexto compacto para o Codex.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "nativeMessaging",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.figma.com/*",
    "https://figma.com/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Abrir Figma Local"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';"
  },
  "key": ""
}
